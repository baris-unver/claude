# Sunucu
PORT=3000
HOST=0.0.0.0

# Veritabanı. Boş bırakılırsa bellek içi (demo) depolama kullanılır.
DATABASE_URL=postgres://ds:ds@localhost:5432/denetimli_serbestlik

# En az 32 karakter. Üretimde mutlaka değiştirin.
JWT_SECRET=change-me-in-production-32-characters-min

# Konum değerlendirme
LOCATION_MAX_ACCURACY_M=100
HEARTBEAT_TIMEOUT_MIN=30
VIOLATION_CONFIRM_SAMPLES=2
