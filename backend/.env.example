# Yüz doğrulama sağlayıcısı: mock | (üretimde kurum SDK adaptörü)
FACE_PROVIDER=mock
FACE_MATCH_THRESHOLD=0.80
MOCK_FACE_SCORE=0.95

# Demo verisi (memur: admin / admin123, hükümlü TC: 10000000146)
SEED_DEMO=true
TIMEZONE=Europe/Istanbul
